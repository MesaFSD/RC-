}

// =============================================================
// CRSF CHANNEL DECODE (16 channels, 11-bit packed)
// =============================================================
void decodeChannels(uint8_t *payload) {
    channels[0]  = ((uint16_t)payload[0]       | (uint16_t)payload[1]  << 8)  & 0x07FF;
    channels[1]  = ((uint16_t)payload[1]  >> 3  | (uint16_t)payload[2]  << 5)  & 0x07FF;
    channels[2]  = ((uint16_t)payload[2]  >> 6  | (uint16_t)payload[3]  << 2  | (uint16_t)payload[4]  << 10) & 0x07FF;
    channels[3]  = ((uint16_t)payload[4]  >> 1  | (uint16_t)payload[5]  << 7)  & 0x07FF;
    channels[4]  = ((uint16_t)payload[5]  >> 4  | (uint16_t)payload[6]  << 4)  & 0x07FF;
    channels[5]  = ((uint16_t)payload[6]  >> 7  | (uint16_t)payload[7]  << 1  | (uint16_t)payload[8]  << 9)  & 0x07FF;
    channels[6]  = ((uint16_t)payload[8]  >> 2  | (uint16_t)payload[9]  << 6)  & 0x07FF;
    channels[7]  = ((uint16_t)payload[9]  >> 5  | (uint16_t)payload[10] << 3)  & 0x07FF;
    channels[8]  = ((uint16_t)payload[11]       | (uint16_t)payload[12] << 8)  & 0x07FF;
    channels[9]  = ((uint16_t)payload[12] >> 3  | (uint16_t)payload[13] << 5)  & 0x07FF;
    channels[10] = ((uint16_t)payload[13] >> 6  | (uint16_t)payload[14] << 2  | (uint16_t)payload[15] << 10) & 0x07FF;
    channels[11] = ((uint16_t)payload[15] >> 1  | (uint16_t)payload[16] << 7)  & 0x07FF;
    channels[12] = ((uint16_t)payload[16] >> 4  | (uint16_t)payload[17] << 4)  & 0x07FF;
    channels[13] = ((uint16_t)payload[17] >> 7  | (uint16_t)payload[18] << 1  | (uint16_t)payload[19] << 9)  & 0x07FF;
    channels[14] = ((uint16_t)payload[19] >> 2  | (uint16_t)payload[20] << 6)  & 0x07FF;
    channels[15] = ((uint16_t)payload[20] >> 5  | (uint16_t)payload[21] << 3)  & 0x07FF;
}

// =============================================================
// CRSF PACKET PROCESSING
// =============================================================
void processCrsfPacket(uint8_t *packet, uint8_t len) {
    if (packet[2] != CRSF_FRAMETYPE_RC) return;
    uint8_t crc = crsf_crc8(&packet[2], crsfPacketLen - 1);
    if (crc != packet[crsfPacketLen + 1]) return;
    decodeChannels(&packet[3]);
    lastValidPacketMs = millis();
    failsafeActive = false;
}

void readCrsf() {
    while (CRSF_SERIAL.available()) {
        uint8_t b = CRSF_SERIAL.read();
        if (crsfBufIndex == 0 && b != CRSF_SYNC_BYTE) continue;
        crsfBuf[crsfBufIndex++] = b;
        if (crsfBufIndex == 2) {
            crsfPacketLen = crsfBuf[1];
            if (crsfPacketLen > CRSF_MAX_PACKET_LEN - 2) {
                crsfBufIndex = 0;
                continue;
            }
        }
        if (crsfBufIndex > 2 && crsfBufIndex == crsfPacketLen + 2) {
            processCrsfPacket(crsfBuf, crsfBufIndex);
            crsfBufIndex = 0;
        }
        if (crsfBufIndex >= CRSF_MAX_PACKET_LEN) crsfBufIndex = 0;
    }
}

// =============================================================
// STEERING (Talon SRX via Servo signal)
// =============================================================
void updateSteering() {
    int raw = channels[STEER_CH];
    if (raw < CRSF_MIN || raw > CRSF_MAX) return;

    int offset = (int)raw - CRSF_CENTER;
    if (INVERT_STEERING) offset = -offset;

    int pulseUs;
    if (abs(offset) <= STEER_DEADBAND) {
        pulseUs = STEER_NEUTRAL;
    } else {
        // Map CRSF range to servo pulse range
        // offset range: -(CRSF_CENTER - CRSF_MIN) to +(CRSF_MAX - CRSF_CENTER)
        // = roughly -820 to +819
        pulseUs = map(raw, CRSF_MIN, CRSF_MAX, STEER_MIN_US, STEER_MAX_US);
        if (INVERT_STEERING) {
            pulseUs = STEER_MIN_US + STEER_MAX_US - pulseUs;
        }
        pulseUs = constrain(pulseUs, STEER_MIN_US, STEER_MAX_US);
    }

    steerServo.writeMicroseconds(pulseUs);
}

// =============================================================
// THROTTLE + REVERSE (proven working, unchanged)
// =============================================================
void throttleStop() {
    throttleCurrentPWM = 0;
    throttleTargetPWM = 0;
    analogWrite(THROTTLE_PIN, 0);
    if (reverseActive) {
        reverseActive = false;
        digitalWrite(REVERSE_PIN, LOW);
    }
}

void updateThrottle() {
    int raw = channels[THROTTLE_CH];
    if (raw < CRSF_MIN || raw > CRSF_MAX) return;

    int offset = raw - CRSF_CENTER;
    if (INVERT_DIRECTION) offset = -offset;

    bool wantForward = (offset > THROTTLE_DEADBAND);
    bool wantReverse = (offset < -THROTTLE_DEADBAND);

    if (!wantForward && !wantReverse) {
        throttleTargetPWM = 0;
        if (throttleCurrentPWM > 0) {
            throttleCurrentPWM = max(throttleCurrentPWM - THROTTLE_RAMP_STEP, 0);
            analogWrite(THROTTLE_PIN, throttleCurrentPWM);
        }
        if (throttleCurrentPWM == 0 && reverseActive) {
            reverseActive = false;
            digitalWrite(REVERSE_PIN, LOW);
        }
        return;
    }

    if (wantReverse != reverseActive) {
        if (throttleCurrentPWM > 0) {
            throttleCurrentPWM = max(throttleCurrentPWM - THROTTLE_RAMP_STEP, 0);
            analogWrite(THROTTLE_PIN, throttleCurrentPWM);
            return;
        }
        reverseActive = wantReverse;
        digitalWrite(REVERSE_PIN, reverseActive ? HIGH : LOW);
    }

    int magnitude = abs(offset) - THROTTLE_DEADBAND;
    int maxOffset = (offset > 0) ? (CRSF_MAX - CRSF_CENTER) - THROTTLE_DEADBAND
                                 : (CRSF_CENTER - CRSF_MIN) - THROTTLE_DEADBAND;

    throttleTargetPWM = map(magnitude, 0, maxOffset, THROTTLE_MIN_PWM, THROTTLE_MAX_PWM);
    throttleTargetPWM = constrain(throttleTargetPWM, THROTTLE_MIN_PWM, THROTTLE_MAX_PWM);

    if (throttleCurrentPWM < throttleTargetPWM)
        throttleCurrentPWM = min(throttleCurrentPWM + THROTTLE_RAMP_STEP, throttleTargetPWM);
    else if (throttleCurrentPWM > throttleTargetPWM)
        throttleCurrentPWM = max(throttleCurrentPWM - THROTTLE_RAMP_STEP, throttleTargetPWM);

    analogWrite(THROTTLE_PIN, throttleCurrentPWM);
}

// =============================================================
// SETUP
// =============================================================
void setup() {
    Serial.begin(115200);
    CRSF_SERIAL.begin(CRSF_BAUDRATE);

    steerServo.attach(STEER_PIN);
    steerServo.writeMicroseconds(STEER_NEUTRAL);

    pinMode(THROTTLE_PIN, OUTPUT);
    digitalWrite(THROTTLE_PIN, LOW);
    analogWrite(THROTTLE_PIN, 0);

    pinMode(REVERSE_PIN, OUTPUT);
    digitalWrite(REVERSE_PIN, LOW);

    Serial.println("============================================");
    Serial.println("  RC GO-KART: STEERING (TALON) + THROTTLE");
    Serial.println("============================================");
    Serial.println("All outputs ZERO/NEUTRAL. Safe to power on.");
    Serial.println("");
    Serial.println("STEERING: Talon SRX on pin 9 (1000-2000us)");
    Serial.println("THROTTLE: EZkontrol on pin 6");
    Serial.print("  Max PWM="); Serial.print(THROTTLE_MAX_PWM);
    Serial.print(" (~"); Serial.print((THROTTLE_MAX_PWM / 255.0) * 5.0, 2);
    Serial.println("V)");
    Serial.print("  Min PWM="); Serial.println(THROTTLE_MIN_PWM);
    Serial.print("  Reverse: pin "); Serial.println(REVERSE_PIN);
    Serial.println("");
    Serial.println("Waiting for CRSF...");
    Serial.println("============================================");
}

// =============================================================
// MAIN LOOP
// =============================================================
void loop() {
    readCrsf();

    if (millis() - lastValidPacketMs > FAILSAFE_MS) {
        if (!failsafeActive) {
            failsafeActive = true;
            steerServo.writeMicroseconds(STEER_NEUTRAL);
            throttleStop();
            Serial.println("[FAILSAFE] Signal lost! All motors stopped.");
        }
        return;
    }

    updateSteering();
    updateThrottle();

    if (millis() - lastPrintMs >= 200) {
        lastPrintMs = millis();
        Serial.print("ST:ch="); Serial.print(channels[STEER_CH]);
        Serial.print(" us="); Serial.print(steerServo.readMicroseconds());
        Serial.print(" | TH:ch="); Serial.print(channels[THROTTLE_CH]);
        Serial.print(" pwm="); Serial.print(throttleCurrentPWM);
        Serial.print(" ~"); Serial.print((throttleCurrentPWM / 255.0) * 5.0, 2);
        Serial.print("V ");
        Serial.println(reverseActive ? "REV" : "FWD");
    }
}
