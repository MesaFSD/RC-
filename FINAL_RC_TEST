// ============================================================
// RC GO-KART CONTROL: STEERING (TALON SRX) + THROTTLE + REVERSE
// Arduino Mega 2560 + RP3 (CRSF) + Talon SRX + EZkontrol
//
// WIRING:
//   RP3 T       -> Pin 19 (RX1)     CRSF data
//   RP3 R       -> Pin 18 (TX1)     Telemetry (optional)
//   RP3 5V/GND  -> Arduino 5V/GND
//   Talon SRX signal -> Pin 9       Servo PWM (1000-2000us)
//   Talon SRX GND    -> Arduino GND
//   Throttle signal  -> Pin 6       PWM to EZkontrol
//   Reverse signal   -> Pin 4       Direction to EZkontrol
//   Throttle/Reverse GND -> Arduino GND
//
// CONTROLS:
//   Right stick LEFT/RIGHT (CH1) = steering
//   Right stick UP/DOWN    (CH2) = throttle + reverse
//   Center = stop / neutral
//
// Upload BEFORE turning on any power systems!
// ============================================================

#include <Servo.h>

// =============================================================
// CRSF CONFIGURATION
// =============================================================
#define CRSF_SERIAL       Serial1
#define CRSF_BAUDRATE     420800

#define CRSF_SYNC_BYTE          0xC8
#define CRSF_FRAMETYPE_RC       0x16
#define CRSF_MAX_PACKET_LEN     64
#define CRSF_NUM_CHANNELS       16

#define CRSF_CENTER   992
#define CRSF_MIN      172
#define CRSF_MAX      1811

// =============================================================
// PIN ASSIGNMENTS
// =============================================================
#define STEER_PIN     9      // Servo signal to Talon SRX
#define THROTTLE_PIN  6      // PWM to EZkontrol throttle
#define REVERSE_PIN   4      // Digital to EZkontrol reverse

// =============================================================
// CHANNEL MAPPING
// =============================================================
#define STEER_CH      0      // CH1 = right stick left/right
#define THROTTLE_CH   1      // CH2 = right stick up/down

// =============================================================
// STEERING TUNING (Talon SRX servo signal)
// =============================================================
#define STEER_NEUTRAL     1500   // Talon SRX neutral (motor stopped)
#define STEER_MIN_US      1000   // Full one direction
#define STEER_MAX_US      2000   // Full other direction
#define STEER_DEADBAND    30     // CRSF units around center stick
#define INVERT_STEERING   false  // Flip if left/right are backwards

// =============================================================
// THROTTLE CONFIGURATION (proven working values)
// =============================================================
#define THROTTLE_DEADBAND     30
#define THROTTLE_MAX_PWM      255     // changed to max PWM value (was before 51)
#define THROTTLE_MIN_PWM      51     // ~1.0V floor.
#define THROTTLE_RAMP_STEP    1
#define INVERT_DIRECTION      true   // Stick up = forward (proven)

// =============================================================
// FAILSAFE
// =============================================================
#define FAILSAFE_MS   500

// =============================================================
// GLOBAL STATE
// =============================================================

// CRSF
uint16_t channels[CRSF_NUM_CHANNELS];
uint8_t  crsfBuf[CRSF_MAX_PACKET_LEN];
uint8_t  crsfBufIndex = 0;
uint8_t  crsfPacketLen = 0;
unsigned long lastValidPacketMs = 0;
bool failsafeActive = true;

// Steering
Servo steerServo;

// Throttle
int throttleCurrentPWM = 0;
int throttleTargetPWM = 0;
bool reverseActive = false;

// Debug
unsigned long lastPrintMs = 0;

// =============================================================
// CRSF CRC8
// =============================================================
